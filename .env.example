# Ops Diagnostics Environment - Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control!

# =============================================================================
# SENTRY
# =============================================================================
# Get your token from: https://sentry.io/settings/account/api/auth-tokens/
# Required scopes: project:read, event:read, issue:read, org:read
#
SENTRY_AUTH_TOKEN=sntrys_your_token_here

# =============================================================================
# SUPABASE
# =============================================================================
# Access token from: https://supabase.com/dashboard/account/tokens
# Project ref from your project URL: https://supabase.com/dashboard/project/<ref>
#
SUPABASE_ACCESS_TOKEN=sbp_your_token_here
SUPABASE_PROJECT_REF=your_project_ref_here

# =============================================================================
# RAILWAY
# =============================================================================
# API token from: https://railway.app/account/tokens
#
RAILWAY_API_TOKEN=your_railway_token_here

# =============================================================================
# KUBERNETES
# =============================================================================
# Option 1: Path to kubeconfig file (for local development)
# KUBECONFIG=/path/to/your/kubeconfig

# Option 2: Base64-encoded kubeconfig (for containers/remote)
# Generate with: base64 -w 0 ~/.kube/config
# KUBECONFIG_B64=base64_encoded_kubeconfig_here

# Optional: Specify a context to use (overrides kubeconfig default)
# KUBE_CONTEXT=my-cluster-context

# =============================================================================
# HUD SDK
# =============================================================================
# API key from: https://hud.ai (required for scenario testing)
# HUD_API_KEY=your_hud_api_key_here

