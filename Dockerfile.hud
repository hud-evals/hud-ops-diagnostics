# Ops Diagnostics Environment
# 
# This Dockerfile builds an environment with access to:
# - Sentry MCP server (via npx @sentry/mcp-server)
# - Supabase MCP server (via npx @supabase/mcp-server-supabase)
# - Custom Railway tools (GraphQL API)
# - Custom kubectl tools (CLI wrapper)
#
# Environment variables (set in HUD dashboard):
# Subagents are auto-detected based on which env vars are set.
#
# - SENTRY_AUTH_TOKEN: Enables Sentry subagent
# - OPENAI_API_KEY: (optional) Enables Sentry AI-powered search
# - SUPABASE_ACCESS_TOKEN: Enables Supabase subagent
# - SUPABASE_PROJECT_REF: (optional) Scopes Supabase to specific project
# - RAILWAY_API_TOKEN: Enables Railway subagent
# - KUBECONFIG_B64 or KUBECONFIG: Enables Kubernetes subagent
# - DOCS_MCP: URL to internal docs MCP server, enables documentation search subagent
# - GITHUB_PAT: GitHub Personal Access Token, enables GitHub subagent

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js (for npx and MCP servers)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install kubectl
RUN curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
    && chmod +x kubectl \
    && mv kubectl /usr/local/bin/

# Install uv for faster Python package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Set working directory
WORKDIR /app

# Copy project files
COPY pyproject.toml uv.lock ./
COPY environments/ ./environments/
COPY orchestrator.py ./
COPY tasks.json ./

# Install Python dependencies
RUN uv sync --frozen 2>/dev/null || uv pip install --system -e .

# Set Python path
ENV PYTHONPATH=/app
ENV PATH=/app/.venv/bin:$PATH

# Pre-install MCP servers globally so they're cached in the image
RUN npm install -g @supabase/mcp-server-supabase@latest @sentry/mcp-server@latest || true

# Environment variable to select which environment to run
# - sentry: Run the Sentry subagent environment (default)
# - orch: Run the orchestrator environment with all subagents
# Override at runtime: docker run -e AGENT_MODE=orch ...
ENV AGENT_MODE=sentry

# Entry point - select environment based on AGENT_MODE
# sentry: hud dev environments.sentry:sentry_env --stdio
# orch: hud dev orchestrator:orch_env --stdio
CMD ["sh", "-c", "if [ \"$AGENT_MODE\" = \"orch\" ]; then hud dev orchestrator:orch_env --stdio; else hud dev environments.sentry:sentry_env --stdio; fi"]
